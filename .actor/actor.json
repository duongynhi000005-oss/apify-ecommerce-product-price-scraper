{
  "actorSpecification": 1,
  "name": "ecommerce-product-price-scraper",
  "title": "Universal E-Commerce Product, Variant, Stock & Price Scraper",
  "description": "Multi-platform e-commerce intelligence engine for Shopify, WooCommerce, Magento, BigCommerce & Schema.org stores. Extracts full SKU variants, real-time stock status, compare-at discounts, GTIN/MPN, ratings, and category listings.",
  "version": "1.0",
  "meta": {
    "templateId": "js-start"
  },
  "input": "./input_schema.json",
  "dockerfile": "./Dockerfile",
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "Universal E-Commerce Product, Variant, Stock & Price Scraper Output",
    "description": "Multi-platform e-commerce intelligence engine for Shopify, WooCommerce, Magento, BigCommerce & Schema.org stores. Extracts full SKU variants, real-time stock status, compare-at discounts, GTIN/MPN, ratings, and category listings.",
    "type": "object",
    "properties": {
      "results": {
        "type": "string",
        "title": "Enriched Dataset Items",
        "template": "{{links.apiDefaultDatasetUrl}}/items"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Universal E-Commerce Product, Variant, Stock & Price Scraper Dataset",
      "description": "Multi-platform e-commerce intelligence engine for Shopify, WooCommerce, Magento, BigCommerce & Schema.org stores. Extracts full SKU variants, real-time stock status, compare-at discounts, GTIN/MPN, ratings, and category listings.",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "url",
              "platform",
              "title",
              "price",
              "currency",
              "inStock",
              "variantsCount"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": {
                "label": "Product URL",
                "format": "text"
              },
              "platform": {
                "label": "Platform",
                "format": "text"
              },
              "title": {
                "label": "Product Title",
                "format": "text"
              },
              "price": {
                "label": "Price",
                "format": "text"
              },
              "currency": {
                "label": "Currency",
                "format": "text"
              },
              "inStock": {
                "label": "In Stock",
                "format": "text"
              },
              "variantsCount": {
                "label": "Variants Count",
                "format": "text"
              }
            }
          }
        }
      },
      "fields": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Product URL",
            "description": "Product URL"
          },
          "platform": {
            "type": "string",
            "title": "Platform",
            "description": "Platform"
          },
          "title": {
            "type": "string",
            "title": "Product Title",
            "description": "Product Title"
          },
          "price": {
            "type": "number",
            "title": "Price",
            "description": "Price"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Currency"
          },
          "inStock": {
            "type": "boolean",
            "title": "In Stock",
            "description": "In Stock"
          },
          "variantsCount": {
            "type": "integer",
            "title": "Variants Count",
            "description": "Variants Count"
          }
        }
      }
    }
  }
}